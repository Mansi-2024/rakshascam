# ==========================================
# RakshaScan - Root .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# Node & Next.js
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
frontend/build/
build/
frontend/.turbo/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
.vercel

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
backend/env/
backend/venv/
backend/.venv/

# Python Distribution & Packaging
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.coverage
.coverage.*
.pytest_cache/
htmlcov/
tests/.pytest_cache/
.nyc_output/
coverage/

# Playwright / Browser Testing Cache & Browsers
backend/.playwright/
.playwright/
playwright-report/
test-results/

# Database & Local Stores
*.sqlite
*.sqlite3
*.db
backend/data/

# Temporary, Logs & Upload Scratchpads
logs/
*.log
backend/uploads/
tmp/
temp/
scratch/
