# ==========================================
# RakshaScan - Environment Configuration Template
# ==========================================
# Copy this file to .env (backend/.env or frontend/.env as needed)
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL.

# ------------------------------------------
# Environment & Application Settings
# ------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_NAME=RakshaScan
APP_VERSION=0.1.0
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# ------------------------------------------
# Backend API (FastAPI)
# ------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------
# Frontend (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=rakshascan_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rakshascan_db
DATABASE_URL=postgresql+asyncpg://rakshascan_user:your_secure_password_here@localhost:5432/rakshascan_db

# ------------------------------------------
# Security & Safety Guards (Analysis Sandboxing)
# ------------------------------------------
# SSRF & Networking limits
ANALYSIS_REQUEST_TIMEOUT_SECONDS=10
ANALYSIS_MAX_REDIRECTS=3
ANALYSIS_MAX_RESPONSE_SIZE_BYTES=5242880  # 5 MB
ANALYSIS_ALLOWED_SCHEMES=http,https

# File Upload Constraints
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------
# Future AI & Verification Services (Placeholders Only)
# ------------------------------------------
# LLM / Reasoning Provider (e.g. OpenAI / Gemini / Claude / Ollama)
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_placeholder
LLM_MODEL_NAME=gemini-2.5-pro

# Official Registries & Verification APIs (Future Pluggable Adapters)
MCA_API_KEY=your_mca_api_key_placeholder
SEBI_REGISTRY_API_KEY=your_sebi_registry_api_key_placeholder
RBI_REGISTRY_API_KEY=your_rbi_registry_api_key_placeholder
WHOIS_API_KEY=your_whois_api_key_placeholder
