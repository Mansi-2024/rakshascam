# ==========================================
# RakshaScan - Environment Configuration Template
# ==========================================
# Copy this file to .env (backend/.env or frontend/.env as needed)
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL.

# ------------------------------------------
# Environment & Application Settings
# ------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_NAME=RakshaScan
APP_VERSION=0.1.0
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# ------------------------------------------
# Backend API (FastAPI) & Security
# ------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# ------------------------------------------
# Frontend (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------
# Rate Limiting & Abuse Defense
# ------------------------------------------
RATE_LIMITING_ENABLED=True
RATE_LIMIT_URL_PER_MINUTE=30
RATE_LIMIT_MESSAGE_PER_MINUTE=30
RATE_LIMIT_SCREENSHOT_PER_MINUTE=15

# ------------------------------------------
# Payload & Networking Sizing Bounds
# ------------------------------------------
MAX_URL_LENGTH=2048
MAX_MESSAGE_CHARACTERS=15000
MAX_IMAGE_BYTES=10485760  # 10 MB
MAX_IMAGE_DIMENSION=8000  # 8000x8000 pixels
MAX_RESPONSE_BYTES=5242880  # 5 MB
CONNECT_TIMEOUT_SECONDS=3.0
READ_TIMEOUT_SECONDS=7.0
TOTAL_TIMEOUT_SECONDS=10.0
MAX_REDIRECTS=3


# ------------------------------------------
# Future AI & Verification Services (Placeholders Only)
# ------------------------------------------
# LLM / Reasoning Provider (e.g. OpenAI / Gemini / Claude / Ollama)
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_placeholder
LLM_MODEL_NAME=gemini-2.5-pro

# Official Registries & Verification APIs (Future Pluggable Adapters)
MCA_API_KEY=your_mca_api_key_placeholder
SEBI_REGISTRY_API_KEY=your_sebi_registry_api_key_placeholder
RBI_REGISTRY_API_KEY=your_rbi_registry_api_key_placeholder
WHOIS_API_KEY=your_whois_api_key_placeholder
